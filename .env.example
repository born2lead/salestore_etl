# Airflow Local Configuration
AIRFLOW_UID=50000

# AWS Region & Credentials
AWS_DEFAULT_REGION=ap-south-1
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# Lakehouse S3 Buckets & Resources (Terraform outputs)
RAW_S3_BUCKET=de-proj-aws-raw-zone-dev
SILVER_S3_BUCKET=de-proj-aws-silver-zone-dev
GOLD_S3_BUCKET=de-proj-aws-gold-zone-dev
ATHENA_RESULTS_BUCKET=de-proj-aws-athena-results-dev
GLUE_DATABASE_NAME=de_proj_aws_db_dev

# SNS Topic ARN for Alerts
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:939139585522:de-proj-aws-pipeline-alerts-dev

# Glue Jobs & Crawlers
GLUE_BRONZE_SILVER_JOB_NAME=de-proj-aws-bronze-to-silver
GLUE_SILVER_GOLD_JOB_NAME=de-proj-aws-silver-to-gold
GLUE_SILVER_CRAWLER_NAME=de-proj-aws-silver-crawler
GLUE_GOLD_CRAWLER_NAME=de-proj-aws-gold-crawler
